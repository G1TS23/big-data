# ─── Secrets ──────────────────────────────────────────────────────────────────
# EDS_SALT : le sel de pseudonymisation ne doit jamais être versionné.
.env
.env.local
*.key
*.pem

# ─── Données ──────────────────────────────────────────────────────────────────
# Rien de ce que le pipeline PRODUIT n'entre dans le dépôt : le lake, les
# journaux et la quarantaine se reconstruisent à partir des sources.
lake/
logs/
_quarantaine/

# Aucun fichier de données par défaut, pour qu'un export échappé ne s'y glisse pas.
*.csv
*.parquet
*.jsonl

# Trois exceptions, et seulement trois.
#
# Le dépôt quotidien du CHU est versionné à la demande de l'enseignant, qui
# fournit ces données et corrigera le projet : cloner le dépôt et lancer le
# pipeline doit suffire, sans se procurer les fichiers ailleurs. Elles sont
# synthétiques — aucun patient réel n'y figure — mais elles portent des NIR et
# des noms de forme réaliste, et le pipeline les traite donc EXACTEMENT comme
# si elles étaient réelles : pseudonymisation dès l'entrée du lake, et rien
# d'identifiant au-delà.
!source-filestorage/**

# Les fixtures de test, synthétiques et réduites.
!tests/fixtures/**/*.csv
!tests/fixtures/**/*.parquet
!tests/fixtures/**/*.jsonl

# ─── Volumes des conteneurs ───────────────────────────────────────────────────
volumes/
clickhouse-data/
metabase-data/

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Les captures du dossier sont un livrable : elles restent versionnées.
!docs/img/**

# ─── Outils et OS ─────────────────────────────────────────────────────────────
.idea/
.vscode/
.DS_Store

# ─── Infrastructure ──────────────────────────────────────────────────────────
# La branche « cloud » porte infra/. Sur main, le répertoire peut subsister dans
# l'arbre de travail après un changement de branche : ces règles évitent qu'un
# « git add -A » n'y ramasse le fournisseur téléchargé (236 Mo) ou, bien pire,
# l'état de Terraform.
#
# L'ÉTAT EST UN SECRET : Terraform y écrit en clair tout ce qu'il connaît, dont
# le mot de passe de la base managée et la clé du compte de stockage.
infra/terraform/.terraform/
infra/terraform/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
TF_VAR_*
