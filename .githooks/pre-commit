#!/bin/sh
# Garde-fou RGPD — empêche une donnée identifiante ou une zone de données
# d'entrer dans l'historique du dépôt.
#
# Deux barrières indépendantes :
#   1. les CHEMINS interdits    — zones de données et secrets, quel qu'en soit le contenu
#   2. le CONTENU des fichiers de données — un NIR, une identité patient
#
# Le contrôle de contenu ne vise que les formats dans lesquels une donnée fuit
# réellement (csv, json, txt, log). Le code et la configuration NOMMENT ces
# colonnes — c'est leur rôle : config/sources.yml déclare précisément qu'il faut
# supprimer nir/nom/prenom, et les tests vérifient que c'est fait. Les scanner
# produirait un refus permanent, donc un hook désactivé en bloc.
#
# Contournement volontaire et tracé : git commit --no-verify

fail=0
staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

for f in $staged; do

  # ── Exception unique : le dépôt quotidien du CHU ────────────────────────────
  # Ces fichiers sont versionnés à la demande de l'enseignant, qui les fournit
  # et corrigera le projet : cloner puis lancer doit suffire. Ils portent des
  # NIR et des noms de forme réaliste, mais sont synthétiques — et le pipeline
  # les traite EXACTEMENT comme s'ils étaient réels : pseudonymisation dès
  # l'entrée du lake, rien d'identifiant au-delà.
  #
  # L'exception est nommément bornée à ce dossier. Tout autre fichier portant
  # une identité reste refusé, ce qui est le but du garde-fou.
  case "$f" in
    source-filestorage/*) continue ;;
  esac

  # ── Barrière 1 : chemins ────────────────────────────────────────────────────
  case "$f" in
    lake/*|logs/*|*_quarantaine/*|.env|*/.env)
      echo "REFUS  $f"
      echo "       zone de données ou secret — ne doit pas être versionné."
      fail=1
      continue
      ;;
  esac

  [ -f "$f" ] || continue

  # ── Barrière 2 : contenu des fichiers de données ────────────────────────────
  # Les fixtures de test sont synthétiques et doivent contenir de faux NIR
  # pour que les tests aient un sens : elles sont exemptées.
  case "$f" in
    tests/fixtures/*) continue ;;
    *.csv|*.tsv|*.json|*.jsonl|*.txt|*.log) ;;
    *) continue ;;
  esac

  content=$(git show ":$f" 2>/dev/null) || continue

  # Champ entier de 15 chiffres = NIR potentiel.
  # Le motif est ancré sur des délimiteurs de champ, et non sur « non-chiffre » :
  # un pseudonyme de 32 caractères hexadécimaux contient statistiquement une
  # suite de 15 chiffres environ une fois sur cent (62,5 % des caractères hex
  # sont des chiffres). Seul un champ qui EST un NIR doit bloquer le commit.
  if printf '%s' "$content" | grep -qIE '(^|[,;"'"'"' \t])[0-9]{15}($|[,;"'"'"' \t])'; then
    echo "REFUS  $f"
    echo "       contient un champ de 15 chiffres (NIR ?)."
    fail=1
  fi

  # En-tête d'un export d'identité patient.
  if printf '%s' "$content" | grep -qiE '\bnir\b.*\bnom\b.*\bprenom\b'; then
    echo "REFUS  $f"
    echo "       ressemble à un export d'identité patient (nir/nom/prenom)."
    fail=1
  fi
done

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "Commit bloqué par .githooks/pre-commit (conformité RGPD)."
  echo "Si le refus est un faux positif, corriger le hook plutôt que de le contourner."
fi
exit $fail
