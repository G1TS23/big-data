# Copier en .env puis renseigner. Le .env n'est jamais versionné.
#
# Génération du sel de pseudonymisation (une seule fois, à conserver) :
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
# ⚠ Changer ce sel casse la continuité des pseudonymes : les jointures avec les
#   données déjà chargées deviennent invalides. Voir docs/EXPLOITATION.md.
EDS_SALT=remplacer_par_un_sel_de_64_caracteres_hexadecimaux

# Emplacement du dépôt quotidien du CHU (lecture seule, hors dépôt git)
EDS_SOURCE_PATH=../eds-chu-sujet/source-filestorage

# Zone de travail locale (générée, ignorée par git)
EDS_LAKE_PATH=./lake

# ─── ClickHouse ───────────────────────────────────────────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_ADMIN_USER=eds_admin
CLICKHOUSE_ADMIN_PASSWORD=changeme

# Comptes cloisonnés par usage (lecture seule sur leur base gold respective)
CLICKHOUSE_PILOTAGE_PASSWORD=changeme
CLICKHOUSE_RECHERCHE_PASSWORD=changeme

# ─── Règles métier ────────────────────────────────────────────────────────────
# Seuil de diffusion des cohortes en recherche (RGPD, petits effectifs)
EDS_K_ANONYMITE=5
